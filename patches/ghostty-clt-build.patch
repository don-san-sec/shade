+        // [shade] CLT-only hosts have no `metal` compiler, so the build
+        // cannot produce the metallib. SHADE_METALLIB points at a prebuilt
+        // metallib (e.g. extracted from an official Ghostty.app of the same
+        // version) which gets embedded instead.
+        const prebuilt = std.process.getEnvVarOwned(b.allocator, "SHADE_METALLIB") catch null;
+        if (prebuilt) |path| {
+            step.root_module.addAnonymousImport("ghostty_metallib", .{
+                .root_source_file = .{ .cwd_relative = path },
+            });
+        } else {
+            const metallib = self.metallib.?;
+            metallib.output.addStepDependencies(&step.step);
+            step.root_module.addAnonymousImport("ghostty_metallib", .{
+                .root_source_file = metallib.output,
+            });
+        }
